{
  "name": "homemade-recipes-monorepo",
  "version": "0.0.0",
  "description": "An extension of @vanilla-extract/recipes that adds responsive variants.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "pnpm -r lint",
    "build": "pnpm --filter \"./packages/**\" run -r build",
    "test": "pnpm -r test",
    "clean": "pnpm run -r clean",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "pnpm build && changeset publish",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "cleandep": "rm -rf node_modules && pnpm -r exec rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@nayhoo/eslint-config": "^1.0.6",
    "@nayhoo/prettier-config": "^1.0.4",
    "@nayhoo/tsconfig": "^1.0.5",
    "@types/node": "20.17.46",
    "@vanilla-extract/css": "^1.16.1",
    "@vanilla-extract/esbuild-plugin": "^2.3.12",
    "@vanilla-extract/vite-plugin": "^3.9.5",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "~9.35.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.1",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml,graphql}": [
      "prettier --write"
    ]
  }
}
