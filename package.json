{
  "name": "homemade-recipes-monorepo",
  "version": "0.0.0",
  "description": "An extension of @vanilla-extract/recipes that adds responsive variants.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "pnpm -r lint",
    "build": "pnpm --filter \"./packages/**\" run -r build",
    "test": "pnpm -r test",
    "clean": "pnpm run -r clean",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "pnpm build && changeset publish",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "cleandep": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "codemod:catalog": "pnpx codemod pnpm/catalog"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/eslintrc": "catalog:",
    "@eslint/js": "catalog:",
    "@nayhoo/eslint-config": "catalog:",
    "@nayhoo/prettier-config": "catalog:",
    "@nayhoo/tsconfig": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/jest": "catalog:",
    "@vanilla-extract/jest-transform": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml,graphql}": [
      "prettier --write"
    ]
  }
}
