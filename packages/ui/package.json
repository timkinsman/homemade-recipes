{
  "name": "@homemade-recipes/ui",
  "private": true,
  "version": "0.0.2",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rm -rf dist",
    "compile": "tsup"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/colors": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/esbuild-plugin": "catalog:",
    "homemade-recipes": "workspace:*",
    "tsup": "catalog:"
  },
  "devDependencies": {
    "@swc/core": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./button": {
      "types": "./dist/components/button.d.ts",
      "default": "./dist/components/button.js"
    },
    "./flex": {
      "types": "./dist/components/flex.d.ts",
      "default": "./dist/components/flex.js"
    },
    "./grid": {
      "types": "./dist/components/grid.d.ts",
      "default": "./dist/components/grid.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme/index.css": {
      "default": "./dist/theme/index.css"
    }
  }
}
